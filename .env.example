# Copy to .env for local DEVELOPMENT. Never commit .env or live keys.
# This file contains no secrets.

VARMA_ENV=development
# TEMPORARY SQLite via StoragePort. Prefer Postgres via docker-compose when Docker is available:
# VARMA_DATABASE_URL=postgresql+psycopg://varma:varma@127.0.0.1:5432/varma
VARMA_DATABASE_URL=sqlite:///data/varma.db

VARMA_TIMEZONE=Europe/London
VARMA_LLM_PROVIDER=fake
# Unused by default. Do not put a live key here. Paid APIs are out of scope for pytest.
# VARMA_LLM_API_KEY=

# DEVELOPMENT auth stub only. Not production identity.
VARMA_BOARD_MEMBER_STUB_TOKEN=dev-board-member

# Encrypted-at-rest backup key. Generate locally. Never commit.
# Not a live broker credential. Live broker credentials must not exist yet.
# VARMA_BACKUP_ENCRYPTION_KEY=

VARMA_API_HOST=127.0.0.1
VARMA_API_PORT=8000

# TEMPORARY DEVELOPMENT DEFAULTS — not Board-approved numbers (OPEN BOARD DECISIONS).
# VARMA_TEMPORARY_BRIEF_COST_CAP_UNITS=100
# VARMA_TEMPORARY_NEWS_FRESH_HOURS=18
# VARMA_TEMPORARY_PRICE_FRESH_HOURS=26
