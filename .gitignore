# Secrets and local env — never commit
.env
.env.local
.env.*.local

# TEMPORARY DEVELOPMENT SQLite (StoragePort). Not the system of record.
# Exception: the practice paper-OPEN book (and its JSON ledger) are tracked so
# the firm floor keeps SHEL.L fills across VMs. Never commit data/varma.db.
data/*
!data/varma_paper_open.db
!data/paper_open_ledger.json
*.db
*.sqlite
*.sqlite3
!data/varma_paper_open.db

# Encrypted backup keys and dump files — never commit company records
*.key
*.dump
*.bak
backups/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
dist/
build/

# Desktop / Electron
desktop/node_modules/
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
